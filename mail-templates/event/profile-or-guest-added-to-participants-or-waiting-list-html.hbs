<div style="margin: 0px auto; max-width: 800px;">
  <table style="width: 100%;" role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
    <tbody>
      <tr>
        <td style="direction: ltr;
            font-size: 0px;
            padding: 50px 0;
            text-align: center;">
          <!--[if mso | IE]><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td class="" style="vertical-align:top;width:800px;" ><![endif]-->
          <div style="font-size: 0px;
              text-align: left;
              direction: ltr;
              display: inline-block;
              vertical-align: top;
              width: 100%;" class="mj-column-per-100 mj-outlook-group-fix">
            <table width="100%" style="vertical-align: top;" role="presentation" cellspacing="0" cellpadding="0"
              border="0">
              <tbody>
                <tr>
                  <td style="font-size: 0px;
                      padding: 10px 25px;
                      word-break: break-word;" align="left">
                    <div style="font-family: Source Sans Pro, Arial;
                        font-size: 13px;
                        line-height: 1.6;
                        text-align: left;
                        color: #154194;">
                      <h2 style="font-weight: 600;
                          margin: 0;
                          padding: 0;
                          font-size: 24px;
                          color: #154194;">
                        {{headline}}
                      </h2>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td style="font-size: 0px;
                      padding: 10px 25px;
                      padding-bottom: 32px;
                      word-break: break-word;" align="left">
                    <div style="font-family: Source Sans Pro, Arial;
                        font-size: 18px;
                        line-height: 1.6;
                        text-align: left;
                        color: #333333;">
                      Hallo {{profile.firstName}},<br><br>
                      {{#if profile.isOnWaitingList}}
                      Du bist auf der Warteliste beim Event <a href="{{event.url}}" style="text-decoration: underline; font-weight: bold;">{{event.name}}</a>.<br><br>
                      {{else}}
                      Du bist für das Event <a href="{{event.url}}" style="text-decoration: underline; font-weight: bold;">{{event.name}}</a> angemeldet.<br><br>
                      {{/if}}
                      Termin: {{event.startDate}}, {{event.startTime}} Uhr ({{event.timezone}})<br>
                      {{#if event.location}}
                      Ort: {{event.location}}<br>
                      {{/if}}
                      {{#if event.conferenceLink}}
                      Konferenz-Link: <a href="{{event.conferenceLink}}" style="text-decoration: underline;">{{event.conferenceLink}}</a><br>
                      {{/if}}
                      <br>
                      Du kannst Dir den Termin am besten direkt im Kalender speichern.<br>
                      <a href="{{event.icsLink}}" style="text-decoration: underline;">{{event.name}}</a><br><br>
                      {{#if profile.isOnWaitingList}}
                      Sobald ein Platz frei wird und Du nachrückst, wirst Du per E-Mail darüber informiert.<br><br>
                      {{else}}
                      {{#if profile.isGuest}}
                      Wenn sich bei Dir etwas ändert und Du doch nicht teilnehmen kannst, dann ziehe bitte Deine Teilnahme über den <a href="{{event.revocationLink}}" style="text-decoration: underline;">Abmeldelink</a> zurück, so dass andere nachrücken können.<br><br>
                      {{else}}
                      Wenn sich bei Dir etwas ändert und Du doch nicht teilnehmen kannst, dann ziehe bitte auf der Community-Plattform Deine Teilnahme zurück, so dass andere nachrücken können.<br><br>
                      {{/if}}
                      {{/if}}
                      Wir freuen uns auf Dich!<br><br>
                      Herzliche Grüße<br>Dein MINTvernetzt-Team
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <!--[if mso | IE]></td></tr></table><![endif]-->
        </td>
      </tr>
    </tbody>
  </table>
</div>