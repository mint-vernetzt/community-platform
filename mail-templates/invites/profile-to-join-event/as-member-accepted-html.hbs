        <div style="margin: 0px auto; max-width: 800px">
          <table style="width: 100%" role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
            <tbody>
              <tr>
                <td style="
                      direction: ltr;
                      font-size: 0px;
                      padding: 1px 0;
                      text-align: center;
                    ">
                  <!--[if mso | IE
                      ]><table
                        role="presentation"
                        border="0"
                        cellpadding="0"
                        cellspacing="0"
                      ></table
                    ><![endif]-->
                </td>
