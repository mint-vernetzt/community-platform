<div style="margin: 0px auto; max-width: 800px;">
  <table style="width: 100%;" role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
    <tbody>
      <tr>
        <td style="direction: ltr;
            font-size: 0px;
            padding: 50px 0;
            text-align: center;">
          <!--[if mso | IE]><table role="presentation" border="0" cellpadding="0" cellspacing="0"><tr><td class="" style="vertical-align:top;width:800px;" ><![endif]-->
          <div style="font-size: 0px;
              text-align: left;
              direction: ltr;
              display: inline-block;
              vertical-align: top;
              width: 100%;" class="mj-column-per-100 mj-outlook-group-fix">
            <table width="100%" style="vertical-align: top;" role="presentation" cellspacing="0" cellpadding="0"
              border="0">
              <tbody>
                <tr>
                    <td
                      style="
                        font-size: 0px;
                        padding: 10px 25px;
                        word-break: break-word;
                      "
                      align="left"
                    >
                      <div
                        style="
                          font-family:
                            Source Sans Pro,
                            Arial;
                          font-size: 13px;
                          line-height: 1.6;
                          text-align: left;
                          color: #154194;
                        "
                      >
                        <h2
                          style="
                            font-weight: 600;
                            margin: 0;
                            padding: 0;
                            font-size: 24px;
                            color: #154194;
                          "
                        >
                          {{headline.de}}
                        </h2>
                      </div>
                    </td>
                  </tr>
                <tr>
                  <td style="
                      font-size: 0px;
                      padding: 10px 25px;
                      padding-bottom: 32px;
                      word-break: break-word;
                    " align="left">
                    <div style="
                        font-family: Source Sans Pro, Arial;
                        font-size: 18px;
                        line-height: 1.6;
                        text-align: left;
                        color: #333333;
                      ">
                      Hallo {{firstName}},<br /><br />
                      Du hast Dich bereits erfolgreich für das Event <b>{{event.name}}</b> angemeldet.<br /><br />
                      Viele Grüße<br />Dein MINTvernetzt-Team<br /><br />
                      P.S.: Über folgenden Link kannst Du jederzeit Deine <a href="{{url}}">Anmeldung widerrufen</a>.
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <!--[if mso | IE]></td></tr></table><![endif]-->
        </td>
      </tr>
    </tbody>
  </table>
</div>

<table
    style="background: #e6e8ec; background-color: #e6e8ec; width: 100%"
    role="presentation"
    cellspacing="0"
    cellpadding="0"
    border="0"
    align="center"
  >
    <tbody>
      <tr>
        <td>
          <!--[if mso | IE]><table align="center" border="0" cellpadding="0" cellspacing="0" class="" role="presentation" style="width:800px;" width="600" bgcolor="#E6E8EC" ><tr><td style="line-height:0px;font-size:0px;mso-line-height-rule:exactly;"><![endif]-->
          <div style="margin: 0px auto; max-width: 800px">
            <table
              style="width: 100%"
              role="presentation"
              cellspacing="0"
              cellpadding="0"
              border="0"
              align="center"
            >
              <tbody>
                <tr>
                  <td
                    style="
                      direction: ltr;
                      font-size: 0px;
                      padding: 1px 0;
                      text-align: center;
                    "
                  >
                    <!--[if mso | IE
                      ]><table
                        role="presentation"
                        border="0"
                        cellpadding="0"
                        cellspacing="0"
                      ></table
                    ><![endif]-->
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <!--[if mso | IE]></td></tr></table><![endif]-->
        </td>
      </tr>
    </tbody>
  </table>

  <div style="margin: 0px auto; max-width: 800px;">
